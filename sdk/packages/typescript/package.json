{
  "name": "stophy",
  "version": "1.2.0",
  "description": "Web scraping API for AI agents. One API to search the web, read what people say, and look up products, places, jobs and homes. Pay only for answers.",
  "keywords": [
    "ads",
    "ai-agents",
    "google-maps",
    "llm",
    "maps",
    "reddit",
    "scraping",
    "sdk",
    "stophy",
    "transcripts",
    "web-data",
    "web-search",
    "youtube"
  ],
  "homepage": "https://stophy.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/sdk.git",
    "directory": "packages/typescript"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "generate": "openapi-ts && bun ../../scripts/gen-surface.ts",
    "build": "tsup",
    "test": "bun test ../../test/typescript",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "prepublishOnly": "bun run generate && bun run build"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "^0.10.2",
    "@hey-api/openapi-ts": "^0.64.0",
    "@types/bun": "^1.1.14",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
