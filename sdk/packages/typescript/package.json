{
  "name": "stophy",
  "version": "1.0.4",
  "description": "Live web data as typed JSON for AI agents. Search, video, social, jobs, places, property and ads behind one key, with a price shown before every call. You pay only for answers that come back.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://stophy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/sdk.git",
    "directory": "packages/typescript"
  },
  "keywords": [
    "stophy",
    "sdk",
    "web-data",
    "web-search",
    "scraping",
    "ai-agents",
    "llm",
    "youtube",
    "reddit",
    "maps",
    "google-maps",
    "transcripts",
    "ads"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts && bun ../../scripts/gen-surface.ts",
    "build": "tsup",
    "test": "bun test ../../test/typescript",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "prepublishOnly": "bun run generate && bun run build"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "^0.10.2",
    "@hey-api/openapi-ts": "^0.64.0",
    "@types/bun": "^1.1.14",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
