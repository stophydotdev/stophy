{
  "name": "stophy-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Official Stophy SDKs — YouTube context API for AI agents. One repo, many languages.",
  "homepage": "https://stophy.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/stophy/stophy-sdk.git"
  },
  "workspaces": [
    "packages/typescript"
  ],
  "scripts": {
    "build": "npm --workspace packages/typescript run build",
    "generate": "npm --workspace packages/typescript run generate",
    "test:ts": "npm --workspace packages/typescript run test",
    "test:py": "uv --project packages/python run pytest",
    "test": "npm run test:ts && npm run test:py"
  }
}
