{
  "name": "@stophy/mcp",
  "version": "1.2.1",
  "description": "Web scraping API for AI agents. One API to search the web, read what people say, and look up products, places, jobs and homes. Pay only for answers.",
  "keywords": [
    "ads",
    "ai-agent",
    "ai-agents",
    "google-maps",
    "google-search",
    "linkedin",
    "llm",
    "mcp",
    "mcp-server",
    "reddit",
    "stophy",
    "transcripts",
    "web-data",
    "web-search",
    "youtube"
  ],
  "homepage": "https://stophy.dev",
  "bugs": {
    "url": "https://github.com/stophydotdev/stophy/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/stophy.git",
    "directory": "mcp"
  },
  "bin": {
    "stophy-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --minify --banner '#!/usr/bin/env node' && chmod +x ./dist/index.js",
    "prepare": "bun run build",
    "start": "node ./dist/index.js",
    "dev": "bun run ./src/index.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.stophydotdev/mcp"
}
