{
  "name": "@stophy/mcp",
  "version": "1.0.5",
  "description": "YouTube context API for AI agents. MCP server that gives AI agents YouTube transcripts, comments, search, and channels as structured JSON.",
  "type": "module",
  "bin": {
    "stophy-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --minify && chmod +x ./dist/index.js",
    "build:http": "bun build ./src/http.ts --outfile ./dist/http.js --target node --minify",
    "prepare": "bun run build",
    "start": "node ./dist/index.js",
    "start:http": "node ./dist/http.js",
    "dev": "bun run ./src/index.ts",
    "dev:http": "bun run ./src/http.ts",
    "check-types": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.24",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stophy",
    "mcp",
    "mcp-server",
    "youtube",
    "youtube-data",
    "youtube-api",
    "youtube-transcript",
    "ai-agent",
    "ai-agents",
    "youtube-for-ai",
    "llm",
    "transcript",
    "search"
  ],
  "mcpName": "io.github.stophydotdev/mcp",
  "homepage": "https://stophy.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/stophydotdev/mcp/issues"
  }
}
