{
  "name": "@stophy/mcp",
  "version": "1.0.3",
  "description": "MCP server for Stophy. The API to search YouTube, get transcripts, read comments, and inspect channels.",
  "type": "module",
  "bin": {
    "stophy-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --minify && chmod +x ./dist/index.js",
    "build:http": "bun build ./src/http.ts --outfile ./dist/http.js --target node --minify",
    "prepare": "bun run build",
    "start": "node ./dist/index.js",
    "start:http": "node ./dist/http.js",
    "dev": "bun run ./src/index.ts",
    "dev:http": "bun run ./src/http.ts",
    "check-types": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.24",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stophy",
    "mcp",
    "youtube",
    "youtube-api",
    "youtube-transcript", 
    "ai-agents",
    "llm",
    "transcript",
    "search"
  ],
  "mcpName": "stophy",
  "homepage": "https://stophy.dev"
  
}
