{
  "name": "@stophy/mcp",
  "version": "2.0.2",
  "description": "One API for live, structured web data. REST, MCP, SDK and CLI.",
  "type": "module",
  "bin": {
    "stophy-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target node --minify && chmod +x ./dist/index.js",
    "prepare": "bun run build",
    "start": "node ./dist/index.js",
    "dev": "bun run ./src/index.ts",
    "check-types": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stophy",
    "mcp",
    "mcp-server",
    "ai-agent",
    "ai-agents",
    "llm",
    "web-data",
    "web-search",
    "youtube",
    "reddit",
    "google-maps",
    "transcripts",
    "ads"
  ],
  "mcpName": "io.github.stophydotdev/mcp",
  "homepage": "https://stophy.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/stophydotdev/mcp/issues"
  }
}
