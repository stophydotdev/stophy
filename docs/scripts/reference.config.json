  "calls": {
    "scrape": {
      "keep": {
        "scrapeId": "id",
        "scrapeRequestId": "requestId"
      }
    },
    "scrapeResult": {
      "use": {
        "id": "scrapeId"
      }
    },
    "scrapeInteract": {
      "body": {
        "code": "console.log(await page.title())",
        "language": "node"
      },
      "use": {
        "id": "scrapeId"
      }
    },
    "scrapeInteractStop": {
      "use": {
        "id": "scrapeId"
      }
    },
    "crawl": {
      "keep": {
        "crawlId": "id"
      }
    },
    "crawlStatus": {
      "use": {
        "id": "crawlId"
      },
      "until": "finished"
    },
    "crawlResults": {
      "use": {
        "id": "crawlId"
      }
    },
    "crawlErrors": {
      "use": {
        "id": "crawlId"
      }
    },
    "crawlCancel": {
      "before": {
        "operation": "crawl",
        "body": {
          "url": "https://bun.com/docs",
          "limit": 2
        },
        "keep": {
          "cancelCrawlId": "id"
        }
      },
      "use": {
        "id": "cancelCrawlId"
      }
    },
    "crawlParams-preview": {
      "body": {
        "url": "https://bun.com/docs",
        "prompt": "Only the runtime pages, at most 10"
      }
    },
    "search": {
      "keep": {
        "searchJobId": "requestId"
      }
    },
    "searchFeedback": {
      "body": {
        "rating": "good"
      },
      "use": {
        "jobId": "searchJobId"
      }
    },
    "searchDeveloper": {
      "body": {
        "query": "bun sqlite",
        "k": 5
      }
    },
    "searchDeveloperGet": {
      "query": {
        "query": "bun sqlite",
        "k": "5"
      }
    },
    "searchResearchPapers": {
      "body": {
        "query": "retrieval augmented generation",
        "k": 5
      },
      "keep": {
        "paperId": "results.0.paperId"
      }
    },
    "searchResearchPapersGet": {
      "query": {
        "query": "retrieval augmented generation",
        "k": "5"
      }
    },
    "researchPaper": {
      "use": {
        "id": "paperId"
      }
    },
    "researchPaperSimilar": {
      "use": {
        "id": "paperId"
      },
      "query": {
        "intent": "evaluating retrieval augmented generation",
        "k": "5"
      }
    },
    "extract": {
      "keep": {
        "extractId": "id"
      }
    },
    "extractResult": {
      "use": {
        "id": "extractId"
      },
      "until": "finished"
    },
    "agent": {
      "keep": {
        "agentId": "id",
        "agentThreadId": "threadId"
      }
    },
    "agentStatus": {
      "use": {
        "id": "agentId"
      },
      "until": "finished"
    },
    "agentTrace": {
      "use": {
        "id": "agentId"
      }
    },
    "agentThread": {
      "use": {
        "threadId": "agentThreadId"
      }
    },
    "parse": {
      "body": {
        "file": "PGgxPkhvdyB0aWRlcyB3b3JrPC9oMT4=",
        "filename": "tides.html"
      }
    },
    "parseUploadUrl": {
      "body": {
        "filename": "report.pdf",
        "contentType": "application/pdf",
        "declaredSizeBytes": 1048576
      }
    },
    "browserCreate": {
      "body": {
        "ttl": 300,
        "activityTtl": 60,
        "recording": true,
        "metadata": {
          "purpose": "docs-example"
        }
      },
      "keep": {
        "sessionId": "id"
      }
    },
    "browserGet": {
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserExecute": {
      "body": {
        "code": "await page.goto('https://example.com'); console.log(await page.title())",
        "language": "node"
      },
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserUpload": {
      "body": {
        "name": "notes.txt",
        "base64": "SGVsbG8gZnJvbSB0aGUgZG9jcw=="
      },
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserDownloads": {
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserProxyGet": {
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserProxyUpdate": {
      "body": {
        "mode": "managed",
        "country": "us"
      },
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserDelete": {
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserRecording": {
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserRecordingDelete": {
      "use": {
        "session_id": "sessionId"
      }
    },
    "browserReplay": {
      "use": {
        "session_id": "sessionId"
      },
      "keep": {
        "replayPageId": "pages.0.pageId"
      }
    },
    "browserReplayPage": {
      "use": {
        "session_id": "sessionId",
        "page_id": "replayPageId"
      }
    },
    "browserProfileCreate": {
      "body": {
        "name": "docs-example"
      },
      "keep": {
        "profileName": "name"
      }
    },
    "browserProfileGet": {
      "use": {
        "name": "profileName"
      }
    },
    "browserProfileUpdate": {
      "body": {
        "name": "docs-example-renamed"
      },
      "use": {
        "name": "profileName"
      },
      "keep": {
        "profileName": "name"
      }
    },
    "browserProfileDelete": {
      "use": {
        "name": "profileName"
      }
    },
    "browserNetworkPolicyCreate": {
      "body": {
        "name": "docs-example",
        "defaultAction": "block",
        "allow": {
          "domains": [
            "bun.com"
          ]
        }
      },
      "keep": {
        "policyId": "id"
      }
    },
    "browserNetworkPolicyGet": {
      "use": {
        "policy_id": "policyId"
      }
    },
    "browserNetworkPolicyUpdate": {
      "body": {
        "name": "docs-example-renamed"
      },
      "use": {
        "policy_id": "policyId"
      }
    },
    "browserNetworkPolicyDelete": {
      "use": {
        "policy_id": "policyId"
      }
    },
    "browserTask": {
      "body": {
        "url": "https://news.ycombinator.com",
        "goal": "Open the newest stories and read the title of the first one",
        "schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            }
          }
        },
        "maxSteps": 4
      },
      "keep": {
        "taskId": "id"
      }
    },
    "browserTaskStatus": {
      "use": {
        "id": "taskId"
      },
      "until": "finished"
    },
    "batchScrape": {
      "keep": {
        "batchId": "id"
      }
    },
    "batchScrapeStatus": {
      "use": {
        "id": "batchId"
      },
      "until": "finished"
    },
    "batchScrapeResults": {
      "use": {
        "id": "batchId"
      }
    },
    "batchScrapeErrors": {
      "use": {
        "id": "batchId"
      }
    },
    "batchScrapeResultsDelete": {
      "use": {
        "id": "batchId"
      }
    },
    "batchScrapeCancel": {
      "before": {
        "operation": "batchScrape",
        "body": {
          "urls": [
            "https://bun.com/docs/runtime/bunfig",
            "https://bun.com/docs/runtime/env"
          ]
        },
        "keep": {
          "cancelBatchId": "id"
        }
      },
      "use": {
        "id": "cancelBatchId"
      }
    },
    "monitorCreate": {
      "body": {
        "name": "Docs example",
        "targets": [
          {
            "type": "scrape",
            "urls": [
              "https://bun.com/docs/runtime/bunfig"
            ]
          }
        ],
        "schedule": {
          "text": "daily"
        }
      },
      "keep": {
        "monitorId": "id"
      }
    },
    "monitorGet": {
      "use": {
        "id": "monitorId"
      }
    },
    "monitorUpdate": {
      "body": {
        "name": "Docs example, renamed"
      },
      "use": {
        "id": "monitorId"
      }
    },
    "monitorChecks": {
      "use": {
        "id": "monitorId"
      },
      "keep": {
        "checkId": "0.id"
      }
    },
    "monitorCheck": {
      "use": {
        "id": "monitorId",
        "checkId": "checkId"
      }
    },
    "monitorChanges": {
      "use": {
        "id": "monitorId"
      }
    },
    "monitorChange": {
      "use": {
        "id": "changeId"
      }
    },
    "monitorWebhookRotate-secret": {
      "use": {
        "id": "monitorId"
      }
    },
    "monitorDelete": {
      "use": {
        "id": "monitorId"
      }
    },
    "webhookSecret": {
      "body": {}
    },
    "getLogs": {
      "query": {
        "limit": "3"
      },
      "keep": {
        "logId": "logs.0.requestId"
      }
    },
    "logsGet": {
      "use": {
        "id": "logId"
      }
    },
    "teamActivity": {
      "query": {
        "limit": "3"
      }
    },
    "signUp": {
      "keep": {
        "signupCode": "code"
      }
    },
    "pollSignUp": {
      "use": {
        "code": "signupCode"
      }
    },
    "feedback": {
      "body": {
        "rating": "good",
        "endpoint": "scrape"
      },
      "use": {
        "jobId": "scrapeRequestId"
      }
    }
