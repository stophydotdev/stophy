  "titles": {
    "scrape": "Scrape",
    "search": "Search",
    "map": "Map",
    "parse": "Parse",
    "crawl": "Crawl",
    "batchScrape": "Batch scrape",
    "extract": "Extract",
    "browserTask": "Browser task",
    "browserTaskStatus": "Browser task status",
    "crawlStatus": "Crawl status",
    "crawlCancel": "Cancel a crawl",
    "batchScrapeStatus": "Batch scrape status",
    "batchScrapeCancel": "Cancel a batch scrape",
    "extractResult": "Extract result",
    "listParsers": "List parsers",
    "getLimits": "Limits",
    "getUsage": "Usage",
    "getLogs": "Logs",
    "signUp": "Sign up",
    "pollSignUp": "Collect the key",
    "revokeKey": "Revoke your key",
    "crawlErrors": "Crawl errors",
    "batchScrapeErrors": "Batch scrape errors"
  },
  "calls": {
    "crawl": {
      "keep": {
        "crawlId": "id"
      }
    },
    "crawlStatus": {
      "use": {
        "id": "crawlId"
      },
      "until": "finished"
    },
    "crawlCancel": {
      "before": {
        "operation": "crawl",
        "body": {
          "url": "https://bun.com/docs",
          "limit": 50
        },
        "keep": {
          "cancelCrawlId": "id"
        }
      },
      "use": {
        "id": "cancelCrawlId"
      }
    },
    "batchScrape": {
      "keep": {
        "batchId": "id"
      }
    },
    "batchScrapeStatus": {
      "use": {
        "id": "batchId"
      },
      "until": "finished"
    },
    "batchScrapeCancel": {
      "before": {
        "operation": "batchScrape",
        "body": {
          "urls": [
            "https://bun.com/docs/runtime/bunfig",
            "https://bun.com/docs/runtime/env",
            "https://bun.com/docs/runtime/shell",
            "https://bun.com/docs/runtime/sqlite",
            "https://bun.com/docs/runtime/http/server"
          ]
        },
        "keep": {
          "cancelBatchId": "id"
        }
      },
      "use": {
        "id": "cancelBatchId"
      }
    },
    "extract": {
      "keep": {
        "extractId": "id"
      }
    },
    "extractResult": {
      "use": {
        "id": "extractId"
      },
      "until": "finished"
    },
    "browserTask": {
      "body": {
        "url": "https://news.ycombinator.com",
        "goal": "Open the newest stories and read the title of the first one",
        "schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            }
          }
        },
        "maxSteps": 4
      },
      "keep": {
        "taskId": "id"
      }
    },
    "browserTaskStatus": {
      "use": {
        "id": "taskId"
      },
      "until": "finished"
    },
    "signUp": {
      "keep": {
        "signupCode": "code"
      }
    },
    "pollSignUp": {
      "use": {
        "code": "signupCode"
      }
    }
  },
  "notCalled": {
    "revokeKey": "Calling it would revoke the key that recorded these examples.",
    "crawlErrors": "No example is recorded. The schema below lists every field.",
    "batchScrapeErrors": "No example is recorded. The schema below lists every field."
  },
  "masks": {
    "getLimits": {
      "balanceCredits": 5000
    },
    "getUsage": {
      "balanceMicros": 10000000,
      "creditsUsed": 120,
      "requestCount": 85
    },
    "getLogs": {
      "apiKeyId": "<apiKeyId>",
      "apiKeyName": "My key",
      "total": 85,
      "totalPages": 2
    }
  },
