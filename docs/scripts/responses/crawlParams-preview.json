{
  "request": {
    "method": "POST",
    "path": "/v1/crawl/params-preview",
    "body": {
      "url": "https://bun.com/docs",
      "prompt": "Only the runtime pages, at most 10"
    }
  },
  "status": 200,
  "response": {
    "success": true,
    "data": {
      "url": "https://bun.com/docs",
      "includePaths": [
        "runtime/.*"
      ],
      "limit": 10
    }
  }
}
