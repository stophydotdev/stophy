{
  "name": "@stophy/cli",
  "version": "1.2.0",
  "description": "Web scraping API for AI agents, in your terminal. One API to search the web, read what people say, and look up products, places, jobs and homes. Pay only for answers.",
  "keywords": [
    "ads",
    "ai-agents",
    "cli",
    "google-maps",
    "llm",
    "maps",
    "mcp",
    "reddit",
    "scraping",
    "stophy",
    "transcripts",
    "web-data",
    "web-search",
    "youtube"
  ],
  "homepage": "https://stophy.dev",
  "bugs": {
    "url": "https://github.com/stophydotdev/stophy/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/stophy.git",
    "directory": "cli"
  },
  "bin": {
    "stophy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/add-shebang.mjs",
    "prepublishOnly": "npm run build",
    "start": "node ./dist/index.js",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "test": "bun test ./tests/account.test.ts ./tests/login.test.ts ./tests/flags.test.ts ./tests/catalog.test.ts ./tests/commands.test.ts ./tests/init.test.ts ./tests/render.test.ts",
    "build:binary": "bash scripts/build-binaries.sh",
    "build:binary:darwin": "bash scripts/build-binaries.sh darwin",
    "build:binary:linux": "bash scripts/build-binaries.sh linux",
    "build:binary:windows": "bash scripts/build-binaries.sh windows"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "conf": "^15.1.0",
    "open": "^11.0.0",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/prompts": "^2.4.9",
    "@types/update-notifier": "^6.0.8",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
